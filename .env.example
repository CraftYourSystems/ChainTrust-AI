# ============================================================
# ChainTrust AI — Next.js frontend configuration
# Copy to .env.local for local dev; set the same keys in the
# Vercel dashboard (Settings -> Environment Variables) to deploy.
# ============================================================

# --- Python analysis engine ---------------------------------
# Where the browser sends the contract for analysis. This fetch runs in the
# USER'S BROWSER, not on Vercel's servers, so localhost resolves to the
# machine viewing the site — which is why a local backend works with a
# deployed frontend. Inlined into the client bundle at BUILD time: changing
# it on Vercel requires a redeploy, not just a restart.
NEXT_PUBLIC_API_URL=http://localhost:8000

# Canonical public URL, used for ARC-0003 NFT metadata links. Leave unset to
# derive it from the incoming request (correct on previews and production).
# NEXT_PUBLIC_SITE_URL=https://your-app.vercel.app

# --- Algorand ------------------------------------------------
# Anchoring runs server-side in a Vercel function and talks to public Algorand
# nodes, so it needs no tunnel. The defaults below target TestNet via AlgoNode
# and only PLATFORM_MNEMONIC is actually required.
NETWORK=testnet
BLOCKCHAIN_PROVIDER=algonode
ALGOD_SERVER=https://testnet-api.algonode.cloud
ALGOD_PORT=443
ALGOD_TOKEN=
INDEXER_SERVER=https://testnet-idx.algonode.cloud
INDEXER_PORT=443
INDEXER_TOKEN=

# 25-word mnemonic of the funded TestNet account that signs proof
# transactions. REQUIRED for /api/ledger/anchor to record anything on-chain;
# without it the report still gets a real SHA-256 hash but stays "Pending".
PLATFORM_MNEMONIC=
PLATFORM_TREASURY_ADDRESS=

# --- Optional: database-backed routes ------------------------
# Only /api/analysis/submit, /api/ledger/[reportId] and /api/payment/* use
# Postgres. The main upload -> analyse -> anchor -> report flow does not.
# Leave DATABASE_URL unset and those routes return 500; everything else works.
# Vercel cannot reach a Postgres on your localhost — use a hosted database
# (Vercel Postgres, Neon, Supabase) if you need these routes deployed.
# DATABASE_URL=postgresql://user:password@host:5432/chaintrust

JWT_SECRET=
PAYMENT_QUOTE_SECRET=
