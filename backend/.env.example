# ============================================================
# ChainTrust AI — backend configuration
# Copy to .env and fill in the key for your chosen provider:
#   cp .env.example .env
# ============================================================

# --- LLM provider -------------------------------------------
# The only switch needed to change providers: "gemini" | "gpt"
LLM_PROVIDER=gemini

# Checked when a provider is instantiated, not at startup — so modules that
# don't call an LLM run without any key. Set both to enable automatic fallback.
GEMINI_API_KEY=
OPENAI_API_KEY=

# Prefer the floating alias. Pinned versions get retired or run out of
# capacity, surfacing as HTTP 404 or 503 on every request.
GEMINI_MODEL=gemini-flash-latest
OPENAI_MODEL=gpt-4o-mini

# --- LLM request behaviour ----------------------------------
# Seconds to wait for a response before timing out.
# Each provider gets one attempt, so worst case is 2 x REQUEST_TIMEOUT.
REQUEST_TIMEOUT=60

# --- Uploads ------------------------------------------------
MAX_FILE_SIZE_MB=10
# Relative paths resolve against backend/. Created on startup if missing.
UPLOAD_DIRECTORY=app/uploads
